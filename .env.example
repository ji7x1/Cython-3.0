# انسخ هذا الملف باسم .env وحط مفتاحك الحقيقي. لا ترفع .env على GitHub.
# Copy to .env and fill in your own key. Never commit .env.

# مفتاح Groq (مطلوب للدردشة): https://console.groq.com/keys
GROQ_API_KEY=

# اختياري / optional
# GROQ_MODEL=llama-3.3-70b-versatile
# MAX_HISTORY_MESSAGES=20
# MAX_CONVERSATIONS=1000
# LLM_TIMEOUT_SECONDS=30
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
# HOST=127.0.0.1
# PORT=8000
# RELOAD=false
